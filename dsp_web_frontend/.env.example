# Frontend environment variables for DSP Web UI

# Base URL for backend API. Example: http://localhost:8000 or https://api.example.com
REACT_APP_API_BASE_URL=http://localhost:8000

# Display name for the app in UI
REACT_APP_APP_NAME=DSP Web UI

# Log level for client-side logging: error | warn | info | debug
REACT_APP_LOG_LEVEL=info
